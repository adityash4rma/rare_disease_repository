# Copy this file to .env and fill in environment-specific values.

# Application
APP_NAME=Rare Disease Repository API
APP_VERSION=1.0.0
DEBUG=True

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./rare_disease.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rare_disease_db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500
